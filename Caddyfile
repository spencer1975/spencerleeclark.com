{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Canonical host: everything lands on www.
	@apex host spencerleeclark.com
	redir @apex https://www.spencerleeclark.com{uri} permanent

	# Once DNS for www.spencerleeclark.com is live, uncomment to send the
	# Railway-provided hostname to the real domain:
	# @railway header_regexp Host \.up\.railway\.app$
	# redir @railway https://www.spencerleeclark.com{uri} permanent

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	header /midjourney-viewer/img/* Cache-Control "public, max-age=604800"

	# Clean URLs: /about -> /about.html; directories redirect to a trailing slash.
	try_files {path} {path}.html
	file_server

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}
